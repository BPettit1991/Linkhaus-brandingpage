      "headline": "Strategy in, systems out.",
      "line": "0480 043 497",
      "about": "AI, automation and growth partner for Australian businesses. Based in NSW, working Australia-wide."
    }
  },
  "portal": {
    "title": "Brand portal",
    "workerName": "linkhaus-brand-portal",
    "bucket": "linkhaus-brand-files",
    "kitDir": "kit"
  },
  "business": {
    "tagline": "Strategy in, systems out.",
    "phone": "0480 043 497",
