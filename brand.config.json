    "areas": [
      "NSW",
      "Australia-wide"
    ],
    "abn": "ABN 39 614 990 330",
    "services": [
      {
        "name": "Operations Partner",
        "icon": "clock",
        "lines": [
          "Admin,",
          "handled."
        ],
        "blurb": "Ongoing admin and workflow automation, built into the tools you already use."
      },
      {
        "name": "Growth Partner",
        "icon": "chart",
        "lines": [
          "Content.",
          "Posting.",
